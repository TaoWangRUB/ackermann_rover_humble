# Thin macOS layer on top of the Linux/Jetson image built from docker/Dockerfile.
# Built through docker/docker-compose.mac.yml. It adds only what the Mac workflow
# needs and the base entrypoint cannot provide at run time:
#   - a rosdep cache for the container user: the base image ran `rosdep update`
#     as root, so the entrypoint's `rosdep install` fails for the non-root user
#     and nothing it lists (gz_ros2_control, BT.CPP v3, ...) ever gets installed
#   - the workspace's rosdep dependencies, resolved from the package manifests
#   - foxglove_bridge, the Mac replacement for RViz (macOS has no X server)
ARG BASE_IMAGE=ackermann_rover_aarch64_jazzy
FROM ${BASE_IMAGE}

ARG USERNAME=nvidia
ARG ROS_DISTRO=jazzy

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

USER ${USERNAME}
RUN rosdep update --rosdistro ${ROS_DISTRO}

# The manifests are bind-mounted from the build context; nothing is copied into
# the image. `-r` keeps going past keys that only matter on the robot.
RUN --mount=type=bind,source=src,target=/tmp/ws/src \
    sudo apt-get update \
    && rosdep install --from-paths /tmp/ws/src --ignore-src --rosdistro ${ROS_DISTRO} -y -r \
    && sudo rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
