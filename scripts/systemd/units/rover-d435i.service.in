[Unit]
Description=Rover: D435i depth camera (waits for its own USB device; after the T265, so its reset can't stall the D435i)
PartOf=rover-stack.target
# A T265 (re)start begins with its hardware reset, which stalls a streaming
# D435i on the shared hub: stop the D435i with it and start it again after.
PartOf=rover-t265.service
Requires=rover-container.service
Wants=rover-t265.service
After=rover-container.service rover-t265.service
StartLimitIntervalSec=900
StartLimitBurst=4

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
ExecStartPre=@REPO@/scripts/rover_units/wait_for.sh usb d435i=8086:0b3a --timeout 0
ExecStart=@REPO@/scripts/rover_units/unit_exec.sh d435i -- ros2 launch realsense_camera_bringup realsense_camera.launch.py enable_d435i:=true enable_l515:=false enable_t265:=false d435i_enable_hardware_reset:=false d435i_startup_delay_s:=0.0
ExecStartPost=@REPO@/scripts/rover_units/wait_for.sh topic /d435i/color/image_raw sensor_msgs/msg/Image --timeout 120
# ExecStopPost also runs when the start failed (ExecStop= does not).
ExecStop=@REPO@/scripts/rover_units/unit_stop.sh d435i
ExecStopPost=@REPO@/scripts/rover_units/unit_stop.sh d435i
# 130/143: stopped by SIGINT/SIGTERM (unit_stop.sh), not a failure.
SuccessExitStatus=130 143
Restart=on-failure
RestartSec=10
TimeoutStartSec=infinity
TimeoutStopSec=60

[Install]
WantedBy=rover-stack.target
