[Unit]
Description=Rover: PX4 link (Micro XRCE-DDS agent on the serial adapter; independent of the cameras)
PartOf=rover-stack.target
Requires=rover-container.service rover-usb.service
# Not ordered after the cameras: a failing camera must not hold up the PX4
# link. ExecStartPre re-enumerates the adapter, so a camera reset that
# disturbed it is cleared before the agent opens it.
After=rover-usb.service
StartLimitIntervalSec=900
StartLimitBurst=4

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
Environment=ROVER_XRCE_DEVICE=/dev/ttyUSB0 ROVER_XRCE_BAUD=921600 ROVER_XRCE_USB_ID=1a86:7523
EnvironmentFile=-/etc/default/rover-stack
# Root (+): re-enumerate the CH340 so a wedged adapter starts clean.
ExecStartPre=+@REPO@/scripts/rover_units/usb_reset.sh ${ROVER_XRCE_USB_ID}
ExecStartPre=@REPO@/scripts/rover_units/wait_for.sh dev ${ROVER_XRCE_DEVICE} --timeout 20
ExecStart=@REPO@/scripts/rover_units/unit_exec.sh xrce -- env LD_LIBRARY_PATH=/opt/microxrce/lib /opt/microxrce/bin/MicroXRCEAgent serial --dev ${ROVER_XRCE_DEVICE} -b ${ROVER_XRCE_BAUD}
ExecStartPost=@REPO@/scripts/rover_units/wait_for.sh topic /fmu/out/vehicle_status_v2 px4_msgs/msg/VehicleStatus --timeout 120
# ExecStopPost also runs when the start failed (ExecStop= does not).
ExecStop=@REPO@/scripts/rover_units/unit_stop.sh xrce 10
ExecStopPost=@REPO@/scripts/rover_units/unit_stop.sh xrce 10
# 130/143: stopped by SIGINT/SIGTERM (unit_stop.sh), not a failure.
SuccessExitStatus=130 143
Restart=on-failure
RestartSec=5
TimeoutStartSec=210
TimeoutStopSec=40

[Install]
WantedBy=rover-stack.target
