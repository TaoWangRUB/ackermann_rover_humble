[Unit]
Description=Rover: MAVLink USB bridge to UDP 14550/14551 (waits for the Cube's USB serial port)
PartOf=rover-stack.target
StartLimitIntervalSec=900
StartLimitBurst=4

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
Environment=ROVER_MAVLINK_DEVICE=/dev/ttyACM0
EnvironmentFile=-/etc/default/rover-stack
ExecStartPre=@REPO@/scripts/rover_units/wait_for.sh dev ${ROVER_MAVLINK_DEVICE} --timeout 0
ExecStart=/usr/bin/python3 @REPO@/scripts/mavlink_bridge.py --serial ${ROVER_MAVLINK_DEVICE} --baud 57600 --out 127.0.0.1:14550 --out 127.0.0.1:14551
Restart=on-failure
RestartSec=5
TimeoutStartSec=infinity

[Install]
WantedBy=rover-stack.target
