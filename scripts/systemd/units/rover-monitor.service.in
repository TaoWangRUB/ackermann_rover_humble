[Unit]
Description=Rover: rover_monitor health + Control Center telemetry/commands over MQTT
PartOf=rover-stack.target
Requires=rover-container.service
# Starts right away: it is how the Control Center sees which part is missing.
After=rover-container.service
StartLimitIntervalSec=900
StartLimitBurst=4

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
Environment=ROVER_BROKER_HOST=192.168.0.225
EnvironmentFile=-/etc/default/rover-stack
ExecStart=@REPO@/scripts/rover_units/unit_exec.sh monitor -- ros2 launch rover_monitor monitor.launch.py use_sim_time:=false depth_camera:=d435i tracking_expect_stream:=false enable_telemetry:=true publisher_config_file:=/workspace/src/rover_monitor/config/publisher.yaml broker_host:=${ROVER_BROKER_HOST}
ExecStartPost=@REPO@/scripts/rover_units/wait_for.sh topic /monitor/health rover_monitor/msg/RoverHealth --timeout 120
# Tag the Control Center's cards as real hardware, as the tmux session does
# ("-": a Control Center that is not up yet does not fail the unit).
ExecStartPost=-/usr/bin/curl -sf -m 5 -X POST -H "Content-Type: application/json" -d '{"camera":"hw","t265":"hw","px4":"hw","jetson":"hw"}' http://${ROVER_BROKER_HOST}:8080/api/hw_mode
# ExecStopPost also runs when the start failed (ExecStop= does not).
ExecStop=@REPO@/scripts/rover_units/unit_stop.sh monitor
ExecStopPost=@REPO@/scripts/rover_units/unit_stop.sh monitor
# 130/143: stopped by SIGINT/SIGTERM (unit_stop.sh), not a failure.
SuccessExitStatus=130 143
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=rover-stack.target
