[Unit]
Description=Rover: dev container up, entrypoint finished
PartOf=rover-stack.target
StartLimitIntervalSec=900
StartLimitBurst=5
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=10
User=@USER@
Group=@GROUP@
WorkingDirectory=@REPO@
ExecStart=@REPO@/scripts/rover_units/wait_for.sh container --timeout 300
TimeoutStartSec=330

[Install]
WantedBy=rover-stack.target
