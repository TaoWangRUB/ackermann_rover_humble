# Git ignore rules for this repository
# Ignore Windows alternate data stream Zone.Identifier files
*:Zone.Identifier

# ROS 2 build artifacts
build/
install/
log/

# Colcon metadata
.colcon/

# Local persistent Docker build caches
docker_cache/

# Node dependencies
node_modules/

# Python bytecode caches
__pycache__/
*.pyc
.venv*/

# Ignor pdf/gv/png files generated by xacro
*.pdf
*.gv
*.png

# Local secret env overrides (use .env.local for passwords/tokens, not .env)
.env.local

# Local files
egpu_diagnostics_*.tar.gz
egpu_diagnostics_20260414_141153/
odom_debug_bag/

# Bag analysis / plotting scratch (commit specific helpers under tools/ instead)
/parse_bag*.py
/plot_bag*.py
/plot_live_bag.py

# Editor / AI tooling
opencode.json
.claude/
.tmp/

# Per-session AI / diagnostic artifacts (commit reusable helpers under tools/ instead)
artifacts/ai/

# RTAB-Map databases (mapping/localization sessions)
.rtabmap/

# rosbag2 recordings
bags/
