<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_transport</transport_id>
      <type>SHM</type>
    </transport_descriptor>

    <transport_descriptor>
      <transport_id>eth_udp_transport</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>${ROS_ETH_INTERFACE_IP}</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="eth_shm_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_transport</transport_id>
        <transport_id>eth_udp_transport</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>