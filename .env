# Docker stack configuration
# ARCH is set automatically from the shell: export ARCH=$(uname -m)  [added to ~/.bashrc]
# Override here only when cross-building (e.g. forcing aarch64 on an x86 host).
UBUNTU_VERSION=24.04
ROS_DISTRO=jazzy
GZ_DISTRO=harmonic
ROS_UBUNTU_CODENAME=noble
IMAGE_NAME=ackermann_rover
CONTAINER_NAME=jazzy_slam
# DDS mode for ROS 2 inside Docker:
#   eth+shm   -> use SHM for same-host traffic and ethernet UDP for diagnostics / remote peers
#   eth-only  -> force the Fast DDS ethernet-only profile (robot / multi-machine diagnostics)
#   local     -> do not force a Fast DDS profile; use builtin transports for same-host workflows
ROS_DDS_MODE=eth+shm
# USERNAME, USER_UID, USER_GID are set automatically from the shell via ~/.bashrc
PX4_DIR=../../PX4-Autopilot
REALSENSE_ROS_DIR=../../realsense-ros
CUDA_HOST_MOUNT=/usr/local/cuda
