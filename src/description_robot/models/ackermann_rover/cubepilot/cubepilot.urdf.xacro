<?xml version="1.0"?>
<!--
  CubePilot (The Cube) flight controller xacro macro.
  Defines the visual mesh, collision box, inertia, IMU sensor link,
  and Gazebo sensor plugins (IMU, barometer, magnetometer, GPS/NavSat)
  required by PX4 SITL.

  The IMU reference frame follows ROS convention (FLU: X-forward, Y-left, Z-up).
  PX4 internally converts FLU -> FRD/NED.

  CubePilot Orange approximate dimensions: 94.5 x 44.3 x 31.6 mm, ~80 g
  Internal IMU offset from board center: approximately 6 mm forward, 6 mm right, 4 mm down
  (see CubeOrange IMU1 datasheet for exact values).

  When enable_px4_sitl is true, an additional "base_link" (no namespace prefix) is
  created with PX4-compatible sensor names so that PX4 gz_bridge can discover them
  at its hardcoded topic paths: /world/{world}/model/{model}/link/base_link/sensor/{name}/{type}
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find description_robot)/models/ackermann_rover/common_properties.urdf.xacro"/>

  <xacro:macro name="cubepilot" params="name parent_link *origin
                                         enable_px4_sitl:=false
                                         imu_update_rate:=200
                                         imu_topic:=/cubepilot/imu
                                         baro_update_rate:=50
                                         baro_topic:=/cubepilot/air_pressure
                                         mag_update_rate:=100
                                         mag_topic:=/cubepilot/magnetometer
                                         gps_update_rate:=30
                                         gps_topic:=/cubepilot/navsat">

    <!-- Board dimensions (metres) -->
    <xacro:property name="board_x"  value="${94.5*mm2m}"/>
    <xacro:property name="board_y"  value="${44.3*mm2m}"/>
    <xacro:property name="board_z"  value="${31.6*mm2m}"/>
    <xacro:property name="board_mass" value="0.080"/>

    <!-- =============== Single link for the whole board =============== -->
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://description_robot/models/ackermann_rover/cubepilot/cubepilot.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="cubepilot_gray">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${board_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${board_x} ${board_y} ${board_z}"/>
        </geometry>
      </collision>
      <xacro:inertial_cuboid mass="${board_mass}" x="${board_x}" y="${board_y}" z="${board_z}"/>
    </link>

    <!-- =============== Gazebo sensors (standard mode) =============== -->
    <xacro:unless value="${enable_px4_sitl}">
    <gazebo reference="${name}_link">
      <!-- IMU -->
      <sensor name="${name}_imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>${imu_update_rate}</update_rate>
        <visualize>false</visualize>
        <topic>${imu_topic}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Air pressure (barometer) -->
      <sensor name="${name}_air_pressure_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>${baro_update_rate}</update_rate>
        <topic>${baro_topic}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <!-- Magnetometer -->
      <sensor name="${name}_magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>${mag_update_rate}</update_rate>
        <topic>${mag_topic}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <!-- NavSat (GPS) -->
      <sensor name="${name}_navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>${gps_update_rate}</update_rate>
        <topic>${gps_topic}</topic>
        <gz_frame_id>${name}_link</gz_frame_id>
      </sensor>

      <xacro:material_darkgray/>
    </gazebo>
    </xacro:unless>

    <!-- =============== PX4 SITL sensors on "base_link" =============== -->
    <!-- PX4 gz_bridge hardcodes: /world/{w}/model/{m}/link/base_link/sensor/{name}/{type}
         We create a separate link named exactly "base_link" (no namespace) so
         the Gazebo topic path matches PX4's expectation. -->
    <xacro:if value="${enable_px4_sitl}">
    <joint name="px4_base_link_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>

    <gazebo reference="base_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>${imu_update_rate}</update_rate>
        <visualize>false</visualize>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>${baro_update_rate}</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>${mag_update_rate}</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>${gps_update_rate}</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
      </sensor>
    </gazebo>

    <gazebo reference="px4_base_link_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    </xacro:if>

    <gazebo reference="${name}_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

  </xacro:macro>
</robot>
